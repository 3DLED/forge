# Local backups exported from the app — keep your training data out of git
forge-backup-*.json

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Local simulation of GitHub Pages subpath hosting
dist-test/

# Licensed exercise animations — deliberately NOT in the repo.
#
# This repo is public. The ExerciseDB licence permits displaying the images inside the app
# and forbids redistributing the files as a downloadable set; committing them here would put
# the whole library one `git clone` away, with an index next to it. The map that references
# them is checked in, the images themselves are fetched into place at build time.
#
# Rebuild locally with:
#   python tools/build_exercise_media.py <path-to-purchased-set> --copy
public/exercise-media/

# The purchased ExerciseDB set, wherever it gets unpacked.
#
# Same reason as public/exercise-media above, and more urgent: this is the whole 530 MB
# library including the raw JSON, which is squarely what the licence means by "the raw files
# as a downloadable exercise database". One `git add -A` in a public repo would publish it.
ExerciseDBstarter/
exercisedb-*/
**/exerciseList.json

# Local backups exported from the app — keep your training data out of git
forge-backup-*.json

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Local simulation of GitHub Pages subpath hosting
dist-test/

# Licensed exercise animations — deliberately NOT in the repo.
#
# This repo is public. The ExerciseDB licence permits displaying the images inside the app
# and forbids redistributing the files as a downloadable set; committing them here would put
# the whole library one `git clone` away, with an index next to it. The map that references
# them is checked in, the images themselves are fetched into place at build time.
#
# Rebuild locally with:
#   python tools/build_exercise_media.py <path-to-purchased-set> --copy
public/exercise-media/

# The purchased ExerciseDB set, wherever it gets unpacked.
#
# Same reason as public/exercise-media above, and more urgent: this is the whole 530 MB
# library including the raw JSON, which is squarely what the licence means by "the raw files
# as a downloadable exercise database". One `git add -A` in a public repo would publish it.
ExerciseDBstarter/
exercise-media-review.html
exercisedb-*/
**/exerciseList.json

# The generated ExerciseDB seed data, and the key that unlocks it.
#
# Same licence, one step further along than the images above. These two files are derived
# from the purchased set rather than copied from it, but between them they carry 1,302 names,
# every description and every instruction -- which is what clause 4 means by a substantially
# similar compilation, and clause 12 forbids publishing one. A public repo does exactly that,
# and a raw GitHub URL is the bulk-download endpoint clause 13 names.
#
# The repo stays public because that is what makes the macOS and Linux runners free. So the
# ciphertext beside these is committed instead, and CI unlocks it before it builds:
#   node tools/seed-crypto.mjs unlock
src/data/seed/catalogue.ts
src/data/seed/enrichment.ts
src/data/seed/names.es.ts
src/data/seed/prose.es.ts
.forge-seed-key

# Python bytecode from the tools.
tools/__pycache__/
